package apamax.blockmarketplace.fetchextension.raw;

/**
 * Only *event* types can be `using`'d across the extension/EPL-App boundary (a *monitor* or
 * plug-in type defined in the extension cannot be referenced directly from the EPL App) - this
 * event exists so ../plugins/GitHubFetchPlugin.py's fetch result can reach
 * repository/epl/FetchExtensionListener.mon. Sent directly by the plugin via
 * Correlator.sendTo(channel, event, type=...) - never touches a connectivity chain, so there's
 * no codec involved and no risk of the binary-truncation issue that motivated using a plugin
 * here in the first place (see that file's header comment).
 */
event GitHubFetchPluginResult {
	string requestId;
	integer statusCode;
	string payload;
	string errorMessage;
}
