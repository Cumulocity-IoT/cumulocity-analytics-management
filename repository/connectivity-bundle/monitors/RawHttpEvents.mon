package apamax.blockmarketplace.fetchextension.raw;

/**
 * Only *event* types can be `using`'d across the extension/EPL-App boundary (a *monitor* or
 * plug-in type defined in the extension cannot be referenced directly from the EPL App).
 *
 * NOTE: The current diagnostic `GitHubFetchPlugin.py` returns its result directly from the
 * action (dictionary return value) and does not publish this event via `Correlator.sendTo(...)`.
 * This event type is kept only for a potential future async variant that would send results
 * across the boundary as events.
 */
event GitHubFetchPluginResult {
	string requestId;
	integer statusCode;
	string payload;
	string errorMessage;
}
