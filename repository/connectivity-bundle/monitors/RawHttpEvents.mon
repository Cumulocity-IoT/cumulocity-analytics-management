package apamax.blockmarketplace.fetchextension.raw;

/**
 * Best-effort draft, unverified against a live correlator — see
 * ../README.md and docs/features/block-marketplace/DIRECT_UPLOAD.md R1.
 *
 * Custom event types mapped (via `apama.eventMap` + `stringCodec`, no
 * JSON codec — see
 * ../FetchExtension.yaml — project root, not config/connectivity/, see README.md Round 8)
 * onto GitHubFetchChain, the one dynamic chain defined there (there used to also be an
 * InventoryUploadChain and its own InventoryUploadRequest/Response event types here - removed,
 * Round 26 - the /inventory/binaries upload now goes through the standard FormRequest/
 * CumulocityRequestInterface APIs directly from FetchExtensionListener.mon, no longer needing
 * its own custom chain or event types). Binary content is always
 * represented here as an EPL `string`, never a raw byte type — the EPL
 * `chunk` type (the only other candidate) explicitly cannot be sent/routed
 * as an event field (confirmed against ApamaDoc), which rules it out for
 * anything that has to travel through a chain to a monitor's listener.
 * NOT actual Base64 (an earlier revision of this bundle used base64Codec,
 * which turned out to be the wrong tool - see FetchExtension.yaml's
 * stringCodec comment, Round 18) - this is `stringCodec` with `encoding:
 * Latin-1`, a lossless byte<->char roundtrip through the string, chosen
 * specifically because base64Codec's fixed direction semantics don't offer
 * an encode operation on the inbound (towardsHost) path our raw HTTP
 * response body actually needs.
 *
 * There used to also be a `RawHttpChainFactory` monitor here wrapping
 * `ConnectivityPlugins.createDynamicChain()` for `FetchExtensionListener.mon`
 * (the EPL App that actually uses these chains) to call via
 * `new RawHttpChainFactory`. Removed: **confirmed by a real EPL App
 * activation failure** that a monitor type defined in an extension can't be
 * `new`'d from a separately-deployed EPL App — Cumulocity's per-EPL-App
 * namespace isolation blocks that specifically for monitor types, even
 * though *event* types (this file's actual exports) cross that boundary
 * fine. `FetchExtensionListener.mon` now calls `createDynamicChain()`
 * directly instead — a plain string-keyed runtime lookup against this
 * bundle's YAML, not a compile-time type reference, so it isn't affected by
 * the same isolation.
 */

/** GET request for a GitHub release asset. `path` should include the leading '/'. */
event GitHubAssetRequest {
	string path;
}

/**
 * Response to a GitHubAssetRequest. `payload` is the response body, as an EPL string via
 * stringCodec's Latin-1 encoding (lossless byte<->char roundtrip - NOT Base64, see this file's
 * header comment).
 * `location` is the redirect target (from the `Location` response header) when `statusCode`
 * is a redirect (301/302/303/307/308) - empty otherwise. GitHub release assets always redirect
 * cross-host to an S3-backed CDN, which HTTPClientTransport's own docs confirm it never follows
 * automatically ("redirects to a different host... are not followed"), so this chain runs with
 * followRedirects: false and FetchExtensionListener.mon follows redirects itself.
 */
event GitHubAssetResponse {
	integer statusCode;
	string payload;
	string location;
}
