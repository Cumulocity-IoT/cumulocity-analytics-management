using com.apama.cumulocity.Event;
using com.apama.cumulocity.ManagedObject;
using com.apama.cumulocity.ObjectCommitted;
using com.apama.cumulocity.ObjectCommitFailed;
using com.apama.cumulocity.GenericRequest;
using com.apama.cumulocity.GenericResponse;
using com.apama.cumulocity.GenericResponseComplete;
using com.apama.cumulocity.Util;
using com.softwareag.connectivity.ConnectivityPlugins;
using apamax.blockmarketplace.fetchextension.raw.GitHubAssetRequest;
using apamax.blockmarketplace.fetchextension.raw.GitHubAssetResponse;
using apamax.blockmarketplace.fetchextension.raw.InventoryUploadRequest;
using apamax.blockmarketplace.fetchextension.raw.InventoryUploadResponse;

/**
 * Event-driven extension deploy flow described in
 * docs/features/block-marketplace/DIRECT_UPLOAD.md.
 *
 * This file is deployed as an EPL App - it depends on
 * repository/connectivity-bundle/ being deployed *separately*, as an
 * Analytics Builder extension, and apama-ctrl having restarted with it
 * loaded *before* this EPL App runs (see that folder's README.md).
 *
 * CONFIRMED IN PRACTICE (real activation attempt): Cumulocity's per-EPL-App
 * namespace isolation ("event definitions from one module cannot be used in
 * other modules" - see EPL Apps docs) blocks referencing a *monitor* type
 * defined in a different deployment unit (a `using` for the extension's
 * `RawHttpChainFactory` monitor, and `new RawHttpChainFactory`, both failed
 * to activate) - but *event* types defined in the extension (the four
 * `using`s below) resolve here just fine. So: never `new` a monitor type
 * from another module: call `ConnectivityPlugins.createDynamicChain()`
 * directly instead (a plain string-keyed runtime lookup against the
 * extension's YAML, not a compile-time type reference - see
 * startFetch()/startUpload()), and only exchange *event* types across the
 * boundary.
 *
 * Two tiers of confidence in this one file - see DIRECT_UPLOAD.md's status
 * line for the full breakdown:
 *   1. VERIFIED IN PRACTICE (multiple rounds of real test -> fix): resolving
 *      the "proxy" managed object that c8y_FetchExtension events are sent
 *      against as their `source` (looked up by external id, created if
 *      missing), listening for those events, and the RECEIVED status event.
 *   2. BEST-EFFORT DRAFT, NEVER RUN (startFetch/onGitHubAssetResponse/
 *      startUpload/onInventoryUploadResponse and everything they call):
 *      the actual GitHub fetch and inventory upload, via the custom
 *      connectivity chains in repository/connectivity-bundle/ (required
 *      because the JSON-codec-only "generic" HttpTransport API used
 *      everywhere in tier 1 would corrupt binary content - see
 *      DIRECT_UPLOAD.md R1) - untested, and known-incomplete in specific
 *      ways DIRECT_UPLOAD.md R1 lists under "Missing information".
 *
 * Prerequisite to double check when testing this: receiving Cumulocity Event
 * notifications in the correlator has historically required a connectivity
 * bundle configuration property to be enabled (documented under the name
 * `subscribeToAllMeasurements` in older Apama/Cumulocity docs, despite the
 * name suggesting it's measurement-specific - confirm the current equivalent
 * for your apama-ctrl version) - if this monitor's Event listener never
 * fires, check that first before assuming the EPL is wrong.
 *
 * External id convention used here (see DIRECT_UPLOAD.md Q1): idType
 * "c8y_Serial", externalId value "c8y_FetchUploadProxy". The managed object
 * itself is plain (no c8y_IsDevice fragment) - it is only an event-source
 * anchor, not a real device.
 */
monitor FetchExtensionListener {

	constant string EVENT_TYPE := "c8y_FetchExtension";

	/**
	 * Status events emitted against the same proxy managed object as
	 * progress/error markers for a given request (correlated by
	 * `requestId`) - see DIRECT_UPLOAD.md Q4/Q5. Because they're plain
	 * Cumulocity Events against a real managed object, they show up on
	 * Cumulocity's own Monitoring/Events page for that object for free - no
	 * new UI needed. This is the equivalent of today's browser-side
	 * `GitHubReleaseError.userMessage` surfacing, moved server-side.
	 */
	constant string STATUS_EVENT_TYPE := "c8y_FetchExtensionStatus";
	constant string STATUS_RECEIVED := "RECEIVED";
	constant string STATUS_DOWNLOADING := "DOWNLOADING";
	constant string STATUS_UPLOADING := "UPLOADING";
	constant string STATUS_SUCCEEDED := "SUCCEEDED";
	constant string STATUS_FAILED := "FAILED";

	constant string PROXY_EXTERNAL_ID_TYPE := "c8y_Serial";
	constant string PROXY_EXTERNAL_ID_VALUE := "c8y_FetchUploadProxy";
	constant string PROXY_MO_NAME := "Fetch Upload Proxy";
	constant string PROXY_MO_TYPE := "c8y_FetchUploadProxy";

	// --- R1/R2 (best-effort, unverified - see repository/connectivity-bundle/README.md) ---

	/**
	 * MISSING INFORMATION / placeholder: conservative guess at a size ceiling
	 * pending R2's real EPL memory-model answer (still not established by
	 * any real test). 20 MB of raw bytes ~= 27 MB of Base64. Adjust once
	 * real testing (or Apama guidance) gives an actual number.
	 */
	constant integer MAX_ASSET_BASE64_LENGTH := 27962026; // ~20 MB raw

	/** Cumulocity id of the proxy managed object, once resolved. Empty until then. */
	string proxySourceId;

	/**
	 * Tenant's own API hostname, needed to create the InventoryUploadChain -
	 * resolved once at startup via GET /tenant/currentTenant's `domain`
	 * field (reusing GenericRequest, the same mechanism already verified
	 * working for the Identity API calls, rather than an unconfirmed
	 * env-var-from-EPL path). Empty until resolveUploadHost() completes.
	 */
	string uploadHost;

	action onload() {
		monitor.subscribe(GenericResponse.SUBSCRIBE_CHANNEL);
		monitor.subscribe(ManagedObject.SUBSCRIBE_CHANNEL);
		monitor.subscribe(Event.SUBSCRIBE_CHANNEL);

		lookupProxyManagedObject();
		resolveUploadHost();
	}

	/**
	 * Resolves uploadHost via GET /tenant/currentTenant. Best-effort,
	 * unverified: the `domain` field's presence/exact meaning (e.g. does it
	 * include a port, is it definitely just a hostname) is taken from a web
	 * search of Cumulocity's REST API docs, not confirmed against a live
	 * response - check the logged raw body if this doesn't work.
	 */
	action resolveUploadHost() {
		integer reqId := Util.generateReqId();

		GenericRequest req := new GenericRequest;
		req.reqId := reqId;
		req.method := "GET";
		req.path := "/tenant/currentTenant";
		req.queryParams := new dictionary<string, string>;
		req.isPaging := false;
		req.body := new any;
		req.headers := new dictionary<string, string>;

		on GenericResponse(reqId = reqId) as resp {
			dictionary<any, any> body := <dictionary<any, any> > resp.getBody();
			uploadHost := body.getOrDefault(<any> "domain").valueToString();
			if uploadHost.length() > 0 {
				log "FetchExtensionListener: resolved uploadHost=" + uploadHost at INFO;
			} else {
				log "FetchExtensionListener: GET /tenant/currentTenant had no usable " +
					"'domain' field - raw body: " + body.toString() at ERROR;
			}
		}
		on GenericResponseComplete(reqId = reqId) as complete {
			if complete.error {
				log "FetchExtensionListener: failed to resolve uploadHost, statusCode=" +
					complete.statusCode.toString() + " details=" + complete.details at ERROR;
			}
		}

		log "FetchExtensionListener: resolving uploadHost via GET /tenant/currentTenant " +
			"(reqId " + reqId.toString() + ")" at INFO;
		send req to GenericRequest.SEND_CHANNEL;
	}

	/** Looks up the proxy managed object by external id (GET /identity/externalIds/{type}/{value}). */
	action lookupProxyManagedObject() {
		integer reqId := Util.generateReqId();

		GenericRequest req := new GenericRequest;
		req.reqId := reqId;
		req.method := "GET";
		req.path := "/identity/externalIds/" + PROXY_EXTERNAL_ID_TYPE + "/" + PROXY_EXTERNAL_ID_VALUE;
		req.queryParams := new dictionary<string, string>;
		req.isPaging := false;
		req.body := new any;
		req.headers := new dictionary<string, string>;

		on GenericResponse(reqId = reqId) as resp and GenericResponseComplete(reqId = reqId) as complete {
			handleLookupComplete(resp, complete);
		}
		on GenericResponseComplete(reqId = reqId) as complete and not GenericResponse(reqId = reqId) {
			// Error responses (e.g. 404 - external id doesn't exist yet) carry no
			// GenericResponse, only the GenericResponseComplete - see GenericRequest's
			// own doc: "If it returned a non-JSON payload... no GenericResponse events
			// will be sent" / "If an error occurred then GenericResponseComplete will
			// contain the error details".
			handleLookupComplete(new GenericResponse, complete);
		}

		log "FetchExtensionListener: looking up proxy managed object external id " +
			PROXY_EXTERNAL_ID_TYPE + "/" + PROXY_EXTERNAL_ID_VALUE + " (reqId " + reqId.toString() + ")" at INFO;
		send req to GenericRequest.SEND_CHANNEL;
	}

	action handleLookupComplete(GenericResponse resp, GenericResponseComplete complete) {
		if not complete.error {
			// Same dictionary<any,any> shape as the Event.params fragment case
			// below (nested JSON objects deserialize with `any`-wrapped keys,
			// not string keys) - untested until this branch first ran, which
			// is why it used the same wrong cast onFetchExtensionEvent() did
			// until that one hit a live CastException.
			dictionary<any, any> body := <dictionary<any, any> > resp.getBody();
			dictionary<any, any> managedObjectRef := <dictionary<any, any> > body.getOrDefault(<any> "managedObject");
			string moId := managedObjectRef.getOrDefault(<any> "id").valueToString();
			log "FetchExtensionListener: found existing proxy managed object, id=" + moId at INFO;
			onProxyManagedObjectResolved(moId);
		} else if complete.statusCode = 404 {
			log "FetchExtensionListener: proxy managed object not found, creating it" at INFO;
			createProxyManagedObject();
		} else {
			log "FetchExtensionListener: lookup of proxy managed object failed, statusCode=" +
				complete.statusCode.toString() + " details=" + complete.details at ERROR;
		}
	}

	/** Creates the proxy managed object (POST via ManagedObject.SEND_CHANNEL). */
	action createProxyManagedObject() {
		integer reqId := Util.generateReqId();

		ManagedObject mo := new ManagedObject;
		mo.name := PROXY_MO_NAME;
		mo.type := PROXY_MO_TYPE;

		on ObjectCommitted(reqId = reqId) as committed {
			log "FetchExtensionListener: created proxy managed object, id=" + committed.id at INFO;
			bindExternalId(committed.id);
		}
		on ObjectCommitFailed(reqId = reqId) as failed {
			log "FetchExtensionListener: failed to create proxy managed object, statusCode=" +
				failed.statusCode.toString() + " body=" + failed.body.valueToString() at ERROR;
		}

		send mo.withChannelResponse(reqId, new dictionary<string, string>) to ManagedObject.SEND_CHANNEL;
	}

	/** Binds the external id to the freshly created managed object (POST /identity/globalIds/{id}/externalIds). */
	action bindExternalId(string managedObjectId) {
		integer reqId := Util.generateReqId();

		GenericRequest req := new GenericRequest;
		req.reqId := reqId;
		req.method := "POST";
		req.path := "/identity/globalIds/" + managedObjectId + "/externalIds";
		req.queryParams := new dictionary<string, string>;
		req.isPaging := false;
		req.body := {"type": <any> PROXY_EXTERNAL_ID_TYPE, "externalId": <any> PROXY_EXTERNAL_ID_VALUE};
		req.headers := new dictionary<string, string>;

		on GenericResponseComplete(reqId = reqId) as complete {
			if not complete.error {
				log "FetchExtensionListener: bound external id " + PROXY_EXTERNAL_ID_VALUE +
					" to managed object " + managedObjectId at INFO;
				onProxyManagedObjectResolved(managedObjectId);
			} else {
				log "FetchExtensionListener: failed to bind external id to managed object " +
					managedObjectId + ", statusCode=" + complete.statusCode.toString() +
					" details=" + complete.details at ERROR;
			}
		}

		send req to GenericRequest.SEND_CHANNEL;
	}

	/** Proxy managed object is ready - start listening for c8y_FetchExtension events against it. */
	action onProxyManagedObjectResolved(string managedObjectId) {
		proxySourceId := managedObjectId;

		on all Event(type = EVENT_TYPE, source = proxySourceId) as e {
			onFetchExtensionEvent(e);
		}

		log "FetchExtensionListener: ready, listening for " + EVENT_TYPE +
			" events with source=" + proxySourceId at INFO;
	}

	/**
	 * Emits a c8y_FetchExtensionStatus event against the proxy managed
	 * object - see the STATUS_* constants' doc comment above (Q4/Q5). A
	 * missing/empty requestId means the caller has nothing to correlate
	 * this against, so callers should avoid calling this without one
	 * (see onFetchExtensionEvent's malformed-request branch, which logs
	 * instead of calling this for exactly that reason).
	 */
	action emitStatus(string requestId, string status, string message) {
		// EPL has no ternary operator (confirmed by a real parser error:
		// "unexpected char: '?'") - use a plain if/else into a local instead.
		string messageSuffix := "";
		if message.length() > 0 {
			messageSuffix := ": " + message;
		}

		Event statusEvent := new Event;
		statusEvent.source := proxySourceId;
		statusEvent.type := STATUS_EVENT_TYPE;
		statusEvent.time := currentTime;
		statusEvent.text := EVENT_TYPE + " " + status + messageSuffix;
		statusEvent.params := {"requestId": <any> requestId, "status": <any> status, "message": <any> message};
		send statusEvent to Event.SEND_CHANNEL;
	}

	/**
	 * Splits a URL into {"host": ..., "path": ...} - https/http-only, no
	 * query-param handling (GitHub release asset URLs don't need it).
	 * Loosely adapted from HttpOutputBlock.mon's splitUrl() (see
	 * DIRECT_UPLOAD.md R1), simplified since we don't need query params
	 * here. Returns an empty dictionary (no "host" key) if the URL doesn't
	 * start with a recognized scheme - callers must check for that rather
	 * than assuming a result, since this deliberately avoids throwing (no
	 * dependency on the Analytics Builder-specific L10N exception helper,
	 * which doesn't apply to a plain monitor like this one).
	 */
	action splitUrl(string url) returns dictionary<string, string> {
		string withoutScheme;
		if url.find("https://") = 0 {
			withoutScheme := url.substring(8, url.length());
		} else if url.find("http://") = 0 {
			withoutScheme := url.substring(7, url.length());
		} else {
			return new dictionary<string, string>;
		}
		integer slashIndex := withoutScheme.find("/");
		string host;
		string path;
		if slashIndex = -1 {
			host := withoutScheme;
			path := "";
		} else {
			host := withoutScheme.substring(0, slashIndex);
			path := withoutScheme.substring(slashIndex, withoutScheme.length());
		}
		return {"host": host, "path": path};
	}

	/**
	 * Maps an upstream (GitHub or inventory) HTTP status code to a
	 * user-facing message, mirroring the categories
	 * GitHubReleaseError.mapErrorResponse() already produces for the
	 * browser-side flow (github-release.service.ts) - kept in sync by hand,
	 * there's no shared source of truth between EPL and TypeScript here.
	 */
	action mapFailureMessage(integer statusCode) returns string {
		if statusCode = 401 {
			return "Authentication failed. The access token is invalid or expired.";
		} else if statusCode = 403 or statusCode = 429 {
			return "Access denied or rate limit exceeded.";
		} else if statusCode = 404 {
			return "Asset not found (it may have been deleted, or the URL is wrong).";
		} else {
			return "Request failed (status " + statusCode.toString() + ").";
		}
	}

	/**
	 * Handles the received event: parses it, emits a RECEIVED status event,
	 * then attempts the real fetch+upload - see the file header comment and
	 * DIRECT_UPLOAD.md R1/R2/R3 for how unverified this part still is
	 * (untested against a live correlator; depends on
	 * repository/connectivity-bundle/ being packaged as an extension and
	 * deployed alongside this EPL App, and on uploadHost having resolved
	 * successfully - see resolveUploadHost()).
	 */
	action onFetchExtensionEvent(Event e) {
		// Deliberately NOT logging e.params.toString() here (and never log the
		// c8y_FetchExtension fragment's `headers` value below either) - per
		// DIRECT_UPLOAD.md Q2, the event is allowed to carry a GitHub PAT in
		// its `headers` fragment (an accepted risk against Cumulocity's event
		// history, not a decision to also multiply that exposure into the
		// correlator's own log files).
		log "FetchExtensionListener: received " + EVENT_TYPE + " event id=" + e.id +
			" text=" + e.text at INFO;

		if e.params.hasKey(EVENT_TYPE) {
			// The nested fragment comes back from JSON as dictionary<any,any> (both
			// keys and values wrapped in `any`), not dictionary<string,any> like
			// e.params itself - confirmed by a CastException at runtime when this
			// used the wrong cast. Look up entries with <any> "key", not "key".
			dictionary<any, any> details := <dictionary<any, any> > e.params.getOrDefault(EVENT_TYPE);
			boolean hasAuth := false;
			if details.hasKey(<any> "headers") {
				dictionary<any, any> headers := <dictionary<any, any> > details.getOrDefault(<any> "headers");
				hasAuth := headers.hasKey(<any> "Authorization");
			}
			string requestId := details.getOrDefault(<any> "requestId").valueToString();
			string url := details.getOrDefault(<any> "url").valueToString();
			string name := details.getOrDefault(<any> "name").valueToString();
			log "FetchExtensionListener: " + EVENT_TYPE + " fragment: url=" + url + " name=" + name +
				" requestId=" + requestId + " hasAuthHeader=" + hasAuth.toString() at INFO;

			if requestId.length() = 0 {
				log "FetchExtensionListener: " + EVENT_TYPE + " fragment has no requestId - " +
					"cannot emit a correlatable status event for it" at WARN;
				return;
			}

			emitStatus(requestId, STATUS_RECEIVED, "Request received, queued for processing");

			if uploadHost.length() = 0 {
				log "FetchExtensionListener: uploadHost has not resolved (see resolveUploadHost() - " +
					"either still pending at startup, or it failed). Cannot proceed with the real " +
					"fetch/upload for requestId=" + requestId at ERROR;
				emitStatus(requestId, STATUS_FAILED, "Server misconfigured (no upload host set) - contact an administrator.");
				return;
			}

			startFetch(requestId, url, name);
		} else {
			log "FetchExtensionListener: event has no " + EVENT_TYPE + " fragment - malformed request?" at WARN;
		}
	}

	/** Starts the GitHub asset fetch - see the class-level R1/R2 comment for how unverified this is. */
	action startFetch(string requestId, string url, string name) {
		dictionary<string, string> urlParts := splitUrl(url);
		if not urlParts.hasKey("host") {
			log "FetchExtensionListener: could not parse url for requestId=" + requestId + ": " + url at ERROR;
			emitStatus(requestId, STATUS_FAILED, "Internal error: could not parse the asset URL.");
			return;
		}
		string host := urlParts.getOrDefault("host");
		string path := urlParts.getOrDefault("path");

		emitStatus(requestId, STATUS_DOWNLOADING, "");

		// Was `new RawHttpChainFactory().createGitHubFetchChain(host)` - a
		// monitor type from the connectivity-bundle extension can't be `new`'d
		// from this EPL App (confirmed by a real activation failure - see the
		// file header comment). createDynamicChain() is a plain string-keyed
		// runtime lookup against that extension's YAML, not a compile-time
		// type reference, so it works fine called directly from here.
		string fetchChannel := "GitHubFetchChannel-" + host;
		monitor.subscribe(fetchChannel);
		ConnectivityPlugins.createDynamicChain(
			"github-fetch-" + host,
			[fetchChannel],
			"GitHubFetchChain",
			{"HOST": host, "PORT": "443"},
			fetchChannel
		);

		GitHubAssetRequest req := new GitHubAssetRequest;
		req.path := path;

		on GitHubAssetResponse() as resp {
			onGitHubAssetResponse(requestId, name, resp);
		}

		send req to fetchChannel;
	}

	action onGitHubAssetResponse(string requestId, string name, GitHubAssetResponse resp) {
		if resp.statusCode >= 200 and resp.statusCode < 300 {
			if resp.payload.length() > MAX_ASSET_BASE64_LENGTH {
				log "FetchExtensionListener: asset for requestId=" + requestId +
					" exceeds MAX_ASSET_BASE64_LENGTH (" + resp.payload.length().toString() +
					" > " + MAX_ASSET_BASE64_LENGTH.toString() + ")" at ERROR;
				emitStatus(requestId, STATUS_FAILED, "Asset is too large to process.");
				return;
			}
			startUpload(requestId, name, resp.payload);
		} else {
			log "FetchExtensionListener: GitHub fetch failed for requestId=" + requestId +
				", statusCode=" + resp.statusCode.toString() at ERROR;
			emitStatus(requestId, STATUS_FAILED, mapFailureMessage(resp.statusCode));
		}
	}

	/**
	 * Starts the inventory upload. `fileBase64` is passed straight through
	 * from the fetch response - still Base64, never decoded to raw bytes in
	 * EPL at any point (see repository/connectivity-bundle/README.md for
	 * why). `metadataJson` is built by hand since this chain has no JSON
	 * codec - mirrors the pas_extension/build_information shape
	 * `InventoryBinaryService.create()` sends today
	 * (extension-inventory.service.ts), but only the minimal fields; nothing
	 * here replicates analyzeZipContent()'s build_information extraction.
	 */
	action startUpload(string requestId, string name, string fileBase64) {
		emitStatus(requestId, STATUS_UPLOADING, "");

		string metadataJson := "{\"name\":\"" + name + "\",\"pas_extension\":\"" + name + "\"}";

		InventoryUploadRequest req := new InventoryUploadRequest;
		req.payload := {"file": <any> fileBase64, "managedObject": <any> metadataJson};
		req.metadata := {"contentType": "multipart/form-data"};

		// See startFetch()'s comment - same fix, monitor types from the
		// extension can't be `new`'d here, so call createDynamicChain()
		// directly instead of going through RawHttpChainFactory.
		string uploadChannel := "InventoryUploadChannel-" + uploadHost;
		monitor.subscribe(uploadChannel);
		ConnectivityPlugins.createDynamicChain(
			"inventory-upload-" + uploadHost,
			[uploadChannel],
			"InventoryUploadChain",
			{"HOST": uploadHost, "PORT": "443"},
			uploadChannel
		);

		on InventoryUploadResponse() as resp {
			onInventoryUploadResponse(requestId, resp);
		}

		send req to uploadChannel;
	}

	action onInventoryUploadResponse(string requestId, InventoryUploadResponse resp) {
		if resp.statusCode >= 200 and resp.statusCode < 300 {
			log "FetchExtensionListener: upload succeeded for requestId=" + requestId at INFO;
			emitStatus(requestId, STATUS_SUCCEEDED, "");
		} else {
			log "FetchExtensionListener: upload failed for requestId=" + requestId +
				", statusCode=" + resp.statusCode.toString() at ERROR;
			emitStatus(requestId, STATUS_FAILED, mapFailureMessage(resp.statusCode));
		}
	}
}
