{
  "name": "analytics-extension",
  "version": "3.0.0",
  "description": "Cumulocity plugin to manage custom Analytics Builder Blocks as extensions.",
  "repository": {
    "type": "git",
    "url": "git@github.com:Cumulocity-IoT/cumulocity-analytics-management.git"
  },
  "scripts": {
    "prestart": "node scripts/optimize-images.js",
    "start": "ng serve",
    "start:admin": "ng serve --shell administration",
    "start:ab": "ng serve --shell streaminganalytics",
    "start:cockpit": "ng serve --shell cockpit",
    "prebuild": "node scripts/optimize-images.js",
    "build": "ng build",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "optimize-images": "node scripts/optimize-images.js",
    "deploy": "ng deploy",
    "format": "prettier --write 'src/**/*.ts'",
    "lint": "eslint --ext .ts,.html . --fix",
    "lint:check": "eslint --ext .ts,.html .",
    "lint:naming": "node scripts/check-naming.js && eslint --no-eslintrc -c .eslintrc.naming.js --ext .ts src"
  },
  "keywords": [
    "c8y"
  ],
  "author": "christof.strack@cumulocity.com",
  "license": "Apache 2.0",
  "dependencies": {
    "@angular/common": "^21.2.20",
    "@angular/compiler": "^21.2.20",
    "@angular/core": "^21.2.20",
    "@angular/forms": "^21.2.20",
    "@angular/platform-browser": "^21.2.20",
    "@angular/router": "^21.2.20",
    "@c8y/bootstrap": "1024.22.2",
    "@c8y/client": "1024.22.2",
    "@c8y/ngx-components": "1024.22.2",
    "@c8y/style": "1024.22.2",
    "@ngx-translate/core": "15.0.0",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "ngx-bootstrap": "21.2.2",
    "rxjs": "7.8.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^18.4.3",
    "@angular-eslint/eslint-plugin-template": "^18.4.3",
    "@angular-eslint/template-parser": "^18.4.3",
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.20",
    "@c8y/devkit": "1024.22.2",
    "@c8y/options": "1024.22.2",
    "@semantic-release/changelog": "^6.0.2",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~5.1.8",
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "eslint-plugin-import": "^2.32.0",
    "file-loader": "^6.2.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "less": "^4.2.0",
    "monaco-editor": "0.55.1",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "typescript": "5.9.3"
  }
}
